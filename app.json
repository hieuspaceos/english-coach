{
  "expo": {
    "name": "English Coach",
    "slug": "english-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "englishcoach",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hieuspace.englishcoach",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "English Coach needs the microphone for speaking practice sessions."
      }
    },
    "android": {
      "package": "com.hieuspace.englishcoach",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@siteed/audio-studio",
      "react-native-audio-api",
      [
        "expo-audio",
        {
          "microphonePermission": "English Coach needs the microphone for speaking practice sessions."
        }
      ]
    ]
  }
}
